    "clientScopeMappings": {
        "pet-backend": [
            {
                "clientScope": "organizations:write",
                "roles": ["organizations:write"]
            }
        ]
    },
    "users": [
        {
            "username": "ukawa",
            "enabled": true,
            "emailVerified": true,
            "firstName": "ukawa",
            "lastName": "ukawa",
