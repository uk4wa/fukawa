# --- Application ---
APP_NAME=pet-uk4wa

LOG_FORMAT=console
LOG_LEVEL=INFO

# --- Application Database ---
DB__DRIVER="postgresql+asyncpg"
DB__HOST=localhost
DB__NAME=pet
DB__USER=admin
DB__PASSWORD=admin
DB__PORT=5432

ENGINE__ECHO=False
ENGINE__POOL_SIZE=10
ENGINE__MAX_OVERFLOW=20
ENGINE__POOL_PRE_PING=True

KEYCLOAK__JWKS_URI=http://keycloak:8080/realms/ukawa-pet/protocol/openid-connect/certs

SESSION_MAKER__EXPIRE_ON_COMMIT=False
SESSION_MAKER__AUTOFLUSH=True

# --- Keycloak server ---
KEYCLOAK__HOSTNAME=http://auth.localhost:8080
KEYCLOAK__ISSUER_URL=http://auth.localhost:8080/realms/ukawa-pet
KEYCLOAK__CLIENT_ID=pet-backend
KEYCLOAK__AUDIENCE=["pet-backend"]
KEYCLOAK__ALLOWED_ALGORITHMS=["RS256"]
KEYCLOAK__JWKS_CACHE_TTL_SECONDS=300
KEYCLOAK__LEEWAY_SECONDS=10
KEYCLOAK__HTTP_TIMEOUT_SECONDS=5

KEYCLOAK__DB_POOL_MIN_SIZE="2"
KEYCLOAK__DB_POOL_MAX_SIZE="20"

KEYCLOAK__ADMIN_USER=admin
KEYCLOAK__ADMIN_PASSWORD=admin

KEYCLOAK__LOG_LEVEL=INFO

# --- Keycloak DB settings
KEYCLOAK_DB__HOST=localhost
KEYCLOAK_DB__PORT=5432
KEYCLOAK_DB__NAME=keycloak-db
KEYCLOAK_DB__USER=admin
KEYCLOAK_DB__PASSWORD=admin